rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Strictly Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Reuseable global helpers following Phase 3 guideline
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 2. Products collection guards
    match /products/{productId} {
      allow read: if true; // Public catalog reads
      
      // Allow creation/modification of products only for logged-in operators
      allow create, update: if isSignedIn() 
        && isValidId(productId)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 150
        && request.resource.data.price is number
        && request.resource.data.price >= 0;
      
      allow delete: if false; // Deletion is disabled in the app sandbox
    }

    // 3. UserProfiles collection guards (PII Isolations)
    match /users/{userId} {
      allow read: if isOwner(userId);
      
      allow create, update: if isOwner(userId)
        && isValidId(userId)
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 100
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100;
        
      allow delete: if false;

      // Unlocked purchase records subcollection (The Master Gate pattern)
      match /purchases/{purchaseId} {
        allow read: if isOwner(userId);
        
        allow create: if isOwner(userId)
          && isValidId(purchaseId)
          && request.resource.data.productId is string
          && request.resource.data.amountPaid is number;
          
        allow update, delete: if false; // Purchases are immutable once processed
      }
    }
  }
}
