rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Strictly Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Reuseable global helpers following Phase 3 guideline
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    // High Security Admin Validation Gate (supports email-based bootstrapping or explicit DB flag)
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'mrflop786@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    // 2. Products collection guards
    match /products/{productId} {
      allow read: if true; // Public catalog reads
      
      // Only authorized administrative users can create or modify catalogue
      allow create, update: if isAdmin() 
        && isValidId(productId)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 150
        && request.resource.data.price is number
        && request.resource.data.price >= 0;
      
      allow delete: if false; // Deletion is disabled in the app sandbox
    }

    // 3. UserProfiles collection guards (PII Isolations & Role-Modification Prevention)
    match /users/{userId} {
      // Users can read their own profiles, admins can look up anyone's profile for management
      allow read: if (isSignedIn() && (resource == null || resource.data.get('email', '') == request.auth.token.email)) || isAdmin();
      
      // Initial registration of profiles
      allow create: if (
        (
          isSignedIn() &&
          request.resource.data.get('email', '') == request.auth.token.email &&
          request.resource.data.get('isAdmin', false) == false &&
          request.resource.data.get('name', '') is string &&
          request.resource.data.get('name', '').size() <= 100 &&
          request.resource.data.get('email', '') is string &&
          request.resource.data.get('email', '').size() <= 100
        ) || isAdmin()
      ) && isValidId(userId);
        
      // Modifications - regular users cannot modify their own isAdmin field, only administrative managers can
      allow update: if (
        (
          isSignedIn() && 
          resource.data.get('email', '') == request.auth.token.email && 
          request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false) &&
          request.resource.data.get('name', '') is string &&
          request.resource.data.get('name', '').size() <= 100 &&
          request.resource.data.get('email', '') is string &&
          request.resource.data.get('email', '').size() <= 100
        ) || isAdmin()
      ) && isValidId(userId);
         
      allow delete: if false;

      // Unlocked purchase records subcollection (The Master Gate pattern)
      match /purchases/{purchaseId} {
        allow read: if (isSignedIn() && get(/databases/$(database)/documents/users/$(userId)).data.get('email', '') == request.auth.token.email) || isAdmin();
        
        allow create: if (isSignedIn() && get(/databases/$(database)/documents/users/$(userId)).data.get('email', '') == request.auth.token.email)
          && isValidId(purchaseId)
          && request.resource.data.productId is string
          && request.resource.data.amountPaid is number;
          
        allow update, delete: if false; // Purchases are immutable once processed
      }
    }

    // 4. Global Settings (Administrative payment gateway details)
    match /settings/{settingId} {
      allow read: if true; // Public checkout needs to view billing credentials
      allow write: if isAdmin() && isValidId(settingId);
    }
  }
}
