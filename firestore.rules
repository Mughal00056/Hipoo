rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Strictly Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Reuseable global helpers following Phase 3 guideline
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // High Security Admin Validation Gate (supports email-based bootstrapping or explicit DB flag)
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'mrflop786@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    // 2. Products collection guards
    match /products/{productId} {
      allow read: if true; // Public catalog reads
      
      // Only authorized administrative users can create or modify catalogue
      allow create, update: if isAdmin() 
        && isValidId(productId)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 150
        && request.resource.data.price is number
        && request.resource.data.price >= 0;
      
      allow delete: if false; // Deletion is disabled in the app sandbox
    }

    // 3. UserProfiles collection guards (PII Isolations & Role-Modification Prevention)
    match /users/{userId} {
      // Users can read their own profiles, admins can look up anyone's profile for management
      allow read: if isOwner(userId) || isAdmin();
      
      // Initial registration of profiles
      allow create: if isOwner(userId)
        && isValidId(userId)
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 100
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && (!request.resource.data.keys().hasAll(['isAdmin']) || request.resource.data.isAdmin == false);
        
      // Modifications - regular users cannot modify their own isAdmin field, only administrative managers can
      allow update: if (
        (isOwner(userId) && (!request.resource.data.keys().hasAll(['isAdmin']) || request.resource.data.isAdmin == resource.data.isAdmin)) ||
        isAdmin()
      )
        && isValidId(userId)
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 100
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100;
         
      allow delete: if false;

      // Unlocked purchase records subcollection (The Master Gate pattern)
      match /purchases/{purchaseId} {
        allow read: if isOwner(userId) || isAdmin();
        
        allow create: if isOwner(userId)
          && isValidId(purchaseId)
          && request.resource.data.productId is string
          && request.resource.data.amountPaid is number;
          
        allow update, delete: if false; // Purchases are immutable once processed
      }
    }

    // 4. Global Settings (Administrative payment gateway details)
    match /settings/{settingId} {
      allow read: if true; // Public checkout needs to view billing credentials
      allow write: if isAdmin() && isValidId(settingId);
    }
  }
}
